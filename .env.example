# Everything here is optional. Co-op Coach works without any of it.

# Free AI (recommended to start): get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Paid, best-quality AI (used instead of Groq when set)
ANTHROPIC_API_KEY=

# Outlook / Hotmail / Microsoft 365 inbox sync (see README → "Connect Outlook")
MS_CLIENT_ID=

# Email digests of new matches (Gmail: smtp.gmail.com / 587 with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Self-hosted ntfy server instead of ntfy.sh
# NTFY_SERVER=https://ntfy.sh
